<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- A console app for browser-wasm: it runs under the wasm app host (node or a browser engine) with no UI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix).$(LibName).WasmSmoke</RootNamespace>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmEnableSIMD>true</WasmEnableSIMD>
    <!-- Invariant globalization would force a native relink with Emscripten; the smoke app does not need it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The golden-hash runner's code runs here too, so the browser rows hash what the desktop rows hash. -->
    <Compile Include="../../tools/GoldenModels/Golden.cs" Link="Golden.cs" />
    <Compile Include="../../bench/Bar/Npy.cs" Link="Npy.cs" />
    <ProjectReference Include="../../src/OneModel/OneModel.csproj" />
  </ItemGroup>

</Project>
