<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix).$(LibName).AotSmoke</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IlcInstructionSet)' == '' and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
    <!-- A NativeAOT binary targets the x86-64 baseline unless told otherwise, and then runs the 4-lane kernels. Applications that
         want the AVX2 kernels set this (x86-64-v3, or native for the machine they publish on); the smoke app checks it took effect. -->
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneModel/OneModel.csproj" />
    <ProjectReference Include="../../src/OneModel.Training/OneModel.Training.csproj" />
    <EmbeddedResource Include="../../testdata/graphs/mlp.onnx" LogicalName="mlp.onnx" />
    <EmbeddedResource Include="../../testdata/graphs/reference.json" LogicalName="reference.json" />
    <EmbeddedResource Include="../../testdata/graphs/shape_ops.onnx" LogicalName="shape_ops.onnx" />
    <EmbeddedResource Include="../../testdata/graphs/shape_ops.json" LogicalName="shape_ops.json" />
    <EmbeddedResource Include="../../testdata/graphs/int8_dyn.onnx" LogicalName="int8_dyn.onnx" />
    <EmbeddedResource Include="../../testdata/graphs/int8_dyn.json" LogicalName="int8_dyn.json" />
    <EmbeddedResource Include="../../testdata/graphs/int8_qdq.onnx" LogicalName="int8_qdq.onnx" />
    <EmbeddedResource Include="../../testdata/graphs/int8_qdq.json" LogicalName="int8_qdq.json" />
  </ItemGroup>

</Project>
