<Project Sdk="Microsoft.NET.Sdk">
  <!-- The bar runner: warm in-process timings of ONNX Runtime (and, once it exists, this library)
       on the same model file and inputs. ONNX Runtime is referenced here and nowhere in src/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <RootNamespace>OneModel.Bar</RootNamespace>
    <AssemblyName>Bar</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- When the central package list gains this version, drop the Version attribute here. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>
</Project>
