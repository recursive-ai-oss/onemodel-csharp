<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(PackagePrefix).$(LibName).Benchmarks</RootNamespace>
    <AssemblyName>$(PackagePrefix).$(LibName).Micro</AssemblyName>
    <!-- The pointer-versus-span comparison calls a microkernel directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneModel/OneModel.csproj" />
    <ProjectReference Include="../../src/OneModel.Training/OneModel.Training.csproj" />
    <Compile Include="../../tests/OneModel.Tests/Kernels/KernelTestData.cs" Link="KernelTestData.cs" />
  </ItemGroup>

</Project>
