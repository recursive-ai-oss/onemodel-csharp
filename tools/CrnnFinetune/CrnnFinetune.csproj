<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fine-tunes a CRNN line recognizer on a pre-generated batch stream and scores it on line sets; see docs/training.md section 10. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OneModel/OneModel.csproj" />
    <ProjectReference Include="../../src/OneModel.Training/OneModel.Training.csproj" />
  </ItemGroup>
</Project>
